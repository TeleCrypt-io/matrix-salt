{% set tls = pillar['tls'] %}
{% set tls_enabled = tls.get('enabled', true) %}
{% set domain = pillar['site']['server_name'] %}
{% set network = pillar['network'] %}
global
    log stdout format raw local0
    user haproxy
    group haproxy
{% if tls_enabled %}
{% if tls.get('certificate_source') is none %}
    setenv ACCOUNT_THUMBPRINT '{{ tls['acme_account_thumbprint'] }}'
{% endif %}
    ssl-default-bind-options ssl-min-ver TLSv1.2 no-tls-tickets
    ssl-load-extra-files key
{% endif %}

defaults
    log global
    mode http
    option httplog
    timeout connect 5s
    timeout client 1h
    timeout server 1h

{% if tls_enabled %}
{% if tls.get('certificate_source') is none %}
frontend acme_http
    bind :80
    http-request return status 200 content-type text/plain lf-string "%[path,field(-1,/)].${ACCOUNT_THUMBPRINT}\n" if { path_reg ^/.well-known/acme-challenge/[-_a-zA-Z0-9]+$ }
    http-request redirect scheme https code 308
{% endif %}

frontend matrix_https
    bind :443 ssl crt /etc/haproxy/certs/{{ tls['cert_name'] }}.pem alpn h2,http/1.1
{% if network.get('ingress_proxy_address') %}
    tcp-request connection reject unless { fc_src {{ network['ingress_proxy_address'] }} }
    tcp-request connection expect-proxy layer4
{% endif %}
    http-request set-header X-Forwarded-For %[src]
    http-request set-header X-Forwarded-Proto https
    http-after-response set-header Strict-Transport-Security "max-age=31536000"
    acl apex hdr(host) -i {{ domain }}
    acl backend_host hdr(host) -i backend.{{ domain }}
    http-request return status 404 unless apex or backend_host
    http-request return status 200 content-type application/json string '{"m.homeserver":{"base_url":"https://backend.{{ domain }}"},"org.matrix.msc2965.authentication":{"issuer":"https://backend.{{ domain }}/","account":"https://backend.{{ domain }}/account/"},"org.matrix.msc4143.rtc_foci":[{"type":"livekit","livekit_service_url":"https://backend.{{ domain }}"}]}' hdr Access-Control-Allow-Origin '*' hdr Cache-Control 'max-age=3600' if apex { method GET } { path -i /.well-known/matrix/client }
    http-request return status 200 content-type application/json string '{"m.server":"backend.{{ domain }}:443"}' if apex { method GET } { path -i /.well-known/matrix/server }
{% if pillar['deployment']['environment'] == 'production' %}
    http-request redirect prefix https://www.{{ domain }} code 301 if apex
{% endif %}
    http-request return status 418 if apex
    # Only this legacy local-token lookup is exposed; room/event federation remains disabled.
    http-request return status 404 if { path_beg /_matrix/federation /_matrix/key /_matrix/server } !{ path -i /_matrix/federation/v1/openid/userinfo }
    http-request return status 404 if { path -i /_matrix/federation/v1/openid/userinfo } !{ method GET }
    acl mas_compat path_reg ^/_matrix/client/[^/]+/(logout|refresh)/?$
    acl mas_path path -i /login /logout /register /account /authorize /link /recover /.well-known/openid-configuration /.well-known/webfinger /.well-known/change-password
    acl mas_prefix path_beg /register/ /account/ /consent/ /device/ /recover/ /upstream/ /complete-compat-sso/ /oauth2/ /graphql /assets/
    acl synapse_path path_beg /_matrix/ /_synapse/client/rendezvous/
    use_backend mas if mas_compat
    use_backend synapse if synapse_path
    use_backend jwt if { path -i /sfu/get /get_token /delegate_delayed_leave /sfu_webhook }
    use_backend livekit_signaling if { path_beg /livekit/ }
    use_backend applications if { path -i /redpill {{ pillar['ingress']['dodo_webhook_path'] }} }
    use_backend applications if { path_beg /plan/ }
    use_backend mas if mas_path or mas_prefix
    default_backend not_found
{% endif %}

# Only the application host reaches administrative APIs; applications still authenticate.
frontend matrix_private
    bind {{ network['private_address'] }}:8080
    http-request deny unless { src {{ network['apps_address'] }} }
    http-request set-header X-Forwarded-For %[src]
    use_backend synapse if { path_beg /_synapse/admin/ }
    use_backend mas_admin if { path_beg /api/admin/ }
    use_backend mas_admin if { path -i /oauth2/token }
    use_backend mas if { path -i /oauth2/userinfo }
    default_backend not_found

backend synapse
    server synapse 127.0.0.1:8008 check

backend mas
    option httpchk GET /health
    server mas 127.0.0.1:8082 check port 8081

backend mas_admin
    server mas_admin 127.0.0.1:8081 check

backend jwt
    server jwt 127.0.0.1:9013 check

backend livekit_signaling
    http-request replace-path ^/livekit/(.*)$ /\1
    server livekit {{ network['livekit_address'] }}:7880 check

backend applications
    server applications {{ network['apps_address'] }}:8080 check

backend not_found
    http-request return status 418
