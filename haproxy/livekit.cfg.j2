global
    log stdout format raw local0
    user haproxy
    group haproxy
    setenv ACCOUNT_THUMBPRINT '{{ pillar['tls']['acme_account_thumbprint'] }}'
    ssl-default-bind-options ssl-min-ver TLSv1.2 no-tls-tickets
    ssl-load-extra-files key

defaults
    log global
    mode tcp
    timeout connect 5s
    timeout client 1h
    timeout server 1h
    timeout tunnel 1h

frontend acme_http
    mode http
    bind :80
    http-request return status 200 content-type text/plain lf-string "%[path,field(-1,/)].${ACCOUNT_THUMBPRINT}\n" if { path_reg ^/.well-known/acme-challenge/[-_a-zA-Z0-9]+$ }
    http-request return status 404

frontend turn_tls
    bind :443 accept-proxy ssl crt /etc/haproxy/certs/{{ pillar["tls"]["cert_name"] }}.pem
    tcp-request content reject if !{ ssl_fc_sni -i {{ pillar['livekit']['turn_host'] }} }
    default_backend bk_livekit_turn

backend bk_livekit_turn
    mode tcp
    server livekit_turn 127.0.0.1:5349 send-proxy-v2 check

