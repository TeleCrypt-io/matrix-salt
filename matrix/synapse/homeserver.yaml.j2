# Synapse — committed application config. Contains no secrets.
# This is the complete public/native configuration. The private JSON input is loaded last and owns
# database, MAS authentication, S3, macaroon and form credentials.

signing_key_path: "/signing.key"          # provided from a private host input (never committed)
pid_file: /tmp/homeserver.pid
log_config: "/log.config"

# Keep Synapse's standard invite state and add only the state needed to classify storage
# invitations before joining. The fixed MSC3089 purpose key identifies a data-tree space;
# m.space.parent is needed to hide invitations for nested folders. The parent state key is the
# parent room ID, so it cannot be narrowed to one fixed key.
room_prejoin_state:
  additional_event_types:
    - [org.matrix.msc3088.purpose, org.matrix.msc3089.data_tree]
    - m.space.parent

# Plain HTTP inside the pod; HAProxy terminates TLS. x_forwarded trusts X-Forwarded-* headers.
listeners:
  - port: 8008
    tls: false
    type: http
    x_forwarded: true
    bind_addresses: ['0.0.0.0']
    resources:
      - names: [client, openid]      # client + narrow OpenID resource; federation remains disabled
        compress: false

# The public identity, explicit rate limits and MatrixRTC settings are rendered below from Pillar.
# The complete database map (driver plus args) and complete
# matrix_authentication_service map (enabled, endpoint, and secret) are supplied by
# synapse.secrets.json. Synapse's config files are shallow-merged by top-level key; keeping partial
# maps here would silently discard required fields from the private map.

server_name: {{ pillar["site"]["server_name"] | tojson }}
public_baseurl: {{ ("https://backend." ~ pillar["site"]["server_name"] ~ "/") | tojson }}

rc_message:
  per_second: {{ pillar["matrix"]["synapse"]["message_per_second"] }}
  burst_count: {{ pillar["matrix"]["synapse"]["message_burst"] }}
rc_room_creation:
  per_second: {{ pillar["matrix"]["synapse"]["room_creation_per_second"] }}
  burst_count: {{ pillar["matrix"]["synapse"]["room_creation_burst"] }}

experimental_features:
  msc3266_enabled: true
  msc4222_enabled: true
  msc4108_enabled: true
  msc3575_enabled: true
  msc4143_enabled: true

matrix_rtc:
  transports:
    - type: livekit
      livekit_service_url: {{ ("https://backend." ~ pillar["site"]["server_name"]) | tojson }}

# media_storage_providers -> synapse.secrets.json. The S3-compatible endpoint is
# sss.telecrypt.io and is reachable only from authorized production and stage Linux VMs. Local
# uploads are stored
# synchronously with private bucket credentials; remote media is disabled.
# macaroon_secret_key and form_secret -> synapse.secrets.json

# Local media staging/cache dir. S3 is the durable media authority; this path is disposable and
# must not be treated as a durable media copy. The image entrypoint clears only this fixed mount.
media_store_path: /staging/media
enable_local_media_storage: false
max_upload_size: 128M
dynamic_thumbnails: false
thumbnail_sizes: []
url_preview_enabled: false

# Federation fully disabled: empty whitelist = federate with nobody (blocks inbound and outbound).
# trusted_key_servers kept explicitly empty so Synapse does NOT fall back to the matrix.org default.
federation_domain_whitelist: []
trusted_key_servers: []

# Auth is fully delegated to MAS — no local registration or password login in Synapse.
enable_registration: false
password_config:
  enabled: false
  localdb_enabled: false

report_stats: false

# Custom user types used by the local policy projection. New accounts start in the native
# unverified state; Cashier changes this field only after an explicit billing transition.
user_types:
  default_user_type: wild
  extra_user_types:
    - wild
    - verified
    - uploads_blocked

# Fail-closed capability restrictions for unverified users (uploads and plaintext events).
# Free users may still create encrypted rooms until their account is suspended.
# Baked into the exact TeleCrypt Synapse image selected by the server release, which contains
# the Controlplane policy-module wheel. Its source and tests live in the control-plane source tree.
modules:
  - module: tier_controller.TierController
    config:
      cashier_internal_url: {{ pillar["endpoints"]["cashier_internal_url"] | tojson }}

# This custom Synapse image contains the Controlplane policy module. Keep the complete feature
# mapping here so the module loads with the released config.
max_event_delay_duration: 24h

# vim:ft=yaml
