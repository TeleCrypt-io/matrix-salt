[Unit]
Description=TeleCrypt Synapse
BindsTo=matrix-pod.service
Requires=mas.service
After=matrix-pod.service mas.service

[Container]
LogDriver=journald
ContainerName=synapse
Image={{ image }}
Pod=matrix.pod
StartWithPod=false
NoNewPrivileges=true
EnvironmentFile=/home/ubuntu/salt_config/secrets/cashier-synapse-token.env
Notify=healthy
Pull=missing
User=991:991
ReadOnly=true
DropCapability=ALL
Environment=TMPDIR=/staging/tmp
Volume=/home/ubuntu/salt_config/runtime/synapse.yaml:/homeserver.yaml:ro
Volume=/home/ubuntu/salt_config/runtime/synapse.log.config:/log.config:ro
Volume=/home/ubuntu/salt_config/secrets/synapse.secrets.json:/secrets.json:ro
Volume=/home/ubuntu/salt_config/secrets/synapse_signing.key:/signing.key:ro
Volume=/home/ubuntu/salt_config/runtime/synapse-staging:/staging:rw
Tmpfs=/tmp:rw,mode=1777
Exec=-c /homeserver.yaml -c /secrets.json
HealthCmd=["curl","-fSs","http://127.0.0.1:8008/health"]
HealthInterval=15s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=15s

[Service]
TimeoutStartSec=900
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
